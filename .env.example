# --- Google auth: pick ONE mode -------------------------------------------
# Mode 1 (default, no service account): sign in as a Google user who can
# access the Shared Drive. Fill in the OAuth client, then run once:
#   docker compose run --rm cv-ocr python -m app.authorize
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CREDENTIALS_FILE=/data/token.json

# Mode 2 (service account key / gcloud credentials file): put the file in
# ./secrets/ and use this instead of the line above:
# GOOGLE_CREDENTIALS_FILE=/secrets/service-account.json
# --------------------------------------------------------------------------

# Drive folder ID where .ocr.txt/.ocr.json results go. Leave empty to write next to each CV.
OUTPUT_FOLDER_ID=

# Recursive folder jobs move each finished CV subfolder into this folder (needs Content manager).
# Leave empty to keep finished folders where they are.
PROCESSED_FOLDER_ID=

# PaddleOCR language (en, fr, german, ch, ...). Changing it requires a rebuild.
OCR_LANG=en
PDF_DPI=200
MAX_PAGES=10
MAX_FILE_MB=25

# If set, clients must send header  X-API-Key: <value>
API_KEY=change-me

PORT=8000

# Set to false only if OCR fails with oneDNN / ConvertPirAttribute errors (slower).
OCR_ENABLE_MKLDNN=true
